<Project Sdk="Microsoft.NET.Sdk">

  <!-- v3.4:TFM/Nullable/ImplicitUsings/警告策略统一由根 Directory.Build.props 提供 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppShell.App</RootNamespace>
    <AssemblyName>WBall</AssemblyName>
    <!-- AppShell 3.0 以入口程序集元数据作为应用身份单一来源。 -->
    <Version>3.5.0</Version>
    <!-- N-01:每显示器 DPI 感知(Per-Monitor V2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AppShell 3.0.3:使用 2026-023-AppShell 的最终冻结包，Core/Services 走传递依赖，
      舞台使用显式 DockSide.Center 契约。
      桌面消费者只需引用 Shell;ServiceHost 是服务宿主消费者才需要的包,这里不引。
    -->
    <PackageReference Include="OneHistory.AppShell.Shell" Version="[3.0.3]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\WBall.Application.csproj" />
  </ItemGroup>

</Project>
