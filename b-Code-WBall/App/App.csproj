<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppShell.App</RootNamespace>
    <AssemblyName>WBall</AssemblyName>
    <!-- N-01:每显示器 DPI 感知(Per-Monitor V2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- v3.0:AppShell 改为已发布包引用(Core/Services 走传递依赖) -->
    <PackageReference Include="OneHistory.AppShell.Shell" Version="0.5.0" />
  </ItemGroup>

</Project>
