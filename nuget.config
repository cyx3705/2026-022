<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      nuget.org + 独立 AppShell 项目本地发布源。
      v3.4 V34-01:本地源改为**相对路径**(相对本文件所在目录),不再写死另一工作树的绝对路径 ——
      换机器 / 换盘符 / 全新 checkout 都能直接 restore。
      默认布局:OneHistory-Projects 下 022 与 023 并列。
      若 023 不在同级目录,把下面的 value 改成 %APPSHELL_FEED%(NuGet 会展开环境变量)并设置该变量即可,
      不需要改工程文件。
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="appshell-local" value="..\2026-023-AppShell\z-Package-AppShell\feed" />
  </packageSources>
</configuration>
